# Copy to .env and fill in values.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Required for local JWT verification when outbound HTTPS to Supabase Auth times out.
# Dashboard: Project Settings -> API -> JWT Secret (legacy symmetric / HS256).
SUPABASE_JWT_SECRET=your_jwt_secret

# Optional: direct SQLAlchemy URL (defaults to sqlite if unset)
# DATABASE_URL=postgresql://...
